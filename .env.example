# Banco de dados PostgreSQL/Supabase
# Copie este arquivo para .env e preencha os valores do novo projeto Supabase.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<SUA_SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true

# Supabase Auth
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<SUA_CHAVE_ANON>

PORT=3000
NODE_ENV=development

# Origens autorizadas a chamar a API via navegador/webview.
# Em produção, informe somente os seus domínios HTTPS separados por vírgula.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010,capacitor://localhost,ionic://localhost

# Integração servidor-a-servidor com um workflow n8n. Crie um segredo longo e aleatório.
# Não use uma chave do Supabase nem um token do Telegram.
N8N_WEBHOOK_SECRET=<SEGREDO_ALEATORIO_LONGO>

# E-mails confirmados com acesso à administração global (separados por vírgula).
ADMIN_EMAILS=
